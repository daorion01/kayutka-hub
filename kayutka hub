	return
end

local playerGui = player:WaitForChild("PlayerGui")

-- إزالة أي واجهة سابقة
local oldGui = playerGui:FindFirstChild("KayutkaMemeDashUI")
if oldGui then
	oldGui:Destroy()
end

local state = {
	SpeedEnabled = true,
	SpeedValue = 32,
	DefaultSpeed = 16,
	AutoJumpEnabled = true,
	JumpCooldown = 0.22
}

local lastJump = 0

local function getHumanoid()
	local char = player.Character
	if not char then
		return nil
	end
	return char:FindFirstChildOfClass("Humanoid")
end

local function applySpeed(hum)
	if not hum or hum.Health <= 0 then
		return
	end
	local targetSpeed = state.SpeedEnabled and state.SpeedValue or state.DefaultSpeed
	if hum.WalkSpeed ~= targetSpeed then
		pcall(function()
			hum.WalkSpeed = targetSpeed
		end)
	end
end

local function hookCharacter(char)
	if not char then
		return
	end
	local hum = char:WaitForChild("Humanoid", 10)
	if not hum then
		return
	end

	applySpeed(hum)

	hum:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
		if state.SpeedEnabled then
			applySpeed(hum)
		end
	end)
end

if player.Character then
	task.spawn(hookCharacter, player.Character)
end

player.CharacterAdded:Connect(function(char)
	task.spawn(hookCharacter, char)
end)

