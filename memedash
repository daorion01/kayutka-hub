    Instance.new("UICorner", F).CornerRadius = UDim.new(0, 7)

    local L = Instance.new("TextLabel", F)
    L.Size, L.Position, L.BackgroundTransparency = UDim2.new(0.7, 0, 1, 0), UDim2.new(0, 10, 0, 0), 1
    L.Text, L.TextColor3, L.TextSize, L.Font, L.TextXAlignment = Locales[Lang][key], Color3.fromRGB(240, 240, 250), 12, Enum.Font.GothamMedium, Enum.TextXAlignment.Left
    table.insert(Refs, { L = L, K = key })

    local B = Instance.new("TextButton", F)
    B.Size, B.Position, B.BackgroundColor3, B.Text = UDim2.new(0, 38, 0, 18), UDim2.new(1, -46, 0.5, -9), def and PURPLE_COLOR or Color3.fromRGB(45, 45, 65), ""
    Instance.new("UICorner", B).CornerRadius = UDim.new(1, 0)

    local C = Instance.new("Frame", B)
    C.Size, C.Position, C.BackgroundColor3 = UDim2.new(0, 14, 0, 14), def and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7), Color3.new(1, 1, 1)
    Instance.new("UICorner", C).CornerRadius = UDim.new(1, 0)

    local s = def
    B.MouseButton1Click:Connect(function()
        s = not s
        C.Position = s and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
        B.BackgroundColor3 = s and PURPLE_COLOR or Color3.fromRGB(45, 45, 65)
        cb(s)
    end)
end

local function AddNum(key, def, minV, maxV, cb)
    local F = Instance.new("Frame", List)
    F.Size, F.BackgroundColor3 = UDim2.new(1, 0, 0, 34), Color3.fromRGB(22, 22, 32)
    Instance.new("UICorner", F).CornerRadius = UDim.new(0, 7)

    local L = Instance.new("TextLabel", F)
    L.Size, L.Position, L.BackgroundTransparency = UDim2.new(0.55, 0, 1, 0), UDim2.new(0, 10, 0, 0), 1
    L.Text, L.TextColor3, L.TextSize, L.Font, L.TextXAlignment = Locales[Lang][key], Color3.fromRGB(240, 240, 250), 12, Enum.Font.GothamMedium, Enum.TextXAlignment.Left
    table.insert(Refs, { L = L, K = key })

    local TB = Instance.new("TextBox", F)
    TB.Size, TB.Position, TB.BackgroundColor3 = UDim2.new(0, 80, 0, 22), UDim2.new(1, -88, 0.5, -11), Color3.fromRGB(32, 32, 45)
    TB.Text, TB.TextColor3, TB.TextSize, TB.Font = tostring(def), PURPLE_COLOR, 12, Enum.Font.GothamBold
    Instance.new("UICorner", TB).CornerRadius = UDim.new(0, 6)
    TB.FocusLost:Connect(function()
        local v = tonumber(TB.Text)
        if v then
            v = math.clamp(v, minV, maxV)
            TB.Text = tostring(v)
            cb(v)
        else
            TB.Text = tostring(def)
        end
    end)
end

