-- Anti-AFK thân thiện với Mobile (không dùng VirtualInputManager)
LP.Idled:Connect(function()
    if getgenv().MemeDashKayutkaConfig.AntiAFK then
        local cam = workspace.CurrentCamera
        if cam then
            cam.CFrame = cam.CFrame * CFrame.Angles(0, math.rad(1), 0)
        end
    end
end)

local function setWalls(on)
    if on then
        table.clear(hiddenWalls)
        for _, v in ipairs(workspace:GetDescendants()) do
            if v:IsA("BasePart") and v.Transparency >= 0.99 and v.CanCollide then
                hiddenWalls[v] = true
                v.CanCollide = false
            end
        end
    else
        for p in pairs(hiddenWalls) do
            if p and p.Parent then p.CanCollide = true end
        end
        table.clear(hiddenWalls)
    end
end

