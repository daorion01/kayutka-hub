RunService.RenderStepped:Connect(function()
    local cfg, char = getgenv().MemeDashKayutkaConfig, LP.Character
    if not char then return end
    local hum, root = char:FindFirstChildOfClass("Humanoid"), char:FindFirstChild("HumanoidRootPart")
    if hum and root then
        if cfg.SpeedHack then hum.WalkSpeed = cfg.WalkSpeed end
        if cfg.WallFling then
            local op = OverlapParams.new()
            op.FilterType, op.FilterDescendantsInstances = Enum.RaycastFilterType.Exclude, { char }
            for _, p in ipairs(workspace:GetPartBoundsInBox(root.CFrame, root.Size + Vector3.new(1, 1, 1), op)) do
                if p.CanCollide then
                    root.AssemblyLinearVelocity = root.CFrame.LookVector * 150 + Vector3.new(0, 50, 0)
                    break
                end
            end
        end
        if cfg.AutoJump and hum.FloorMaterial ~= Enum.Material.Air and not cfg.AutoFarmLevel then
            hum:ChangeState(Enum.HumanoidStateType.Jumping)
        end
        if cfg.AutoFarmLevel then
            if not AirPos then AirPos = root.Position + Vector3.new(0, 60, 0) end
            root.CFrame, root.AssemblyLinearVelocity = CFrame.new(AirPos), Vector3.zero
        end
    end
    if cfg.Noclip then
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end
end)
