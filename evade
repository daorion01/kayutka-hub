local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

local Settings = {
    NormalSpeed = false,
    InfinitySlide = false,
    AutoJump = false
}

local gui = Instance.new("ScreenGui")
gui.Name = "KayutkaHub"
gui.ResetOnSpawn = false
gui.Parent = LocalPlayer:WaitForChild("PlayerGui")

local frame = Instance.new("Frame")
frame.Size = UDim2.new(0, 260, 0, 260)
frame.Position = UDim2.new(0.5, -130, 0.5, -130)
frame.BackgroundColor3 = Color3.fromRGB(30, 15, 50)
frame.Active = true
frame.Draggable = true
frame.Parent = gui

local function makeBtn(txt, y, key)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(0.85, 0, 0, 42)
    b.Position = UDim2.new(0.075, 0, 0, y)
    b.BackgroundColor3 = Color3.fromRGB(90, 35, 160)
    b.TextColor3 = Color3.fromRGB(255, 255, 255)
    b.Text = txt .. " : OFF"
    b.Parent = frame

    local on = false
    b.MouseButton1Click:Connect(function()
        on = not on
        Settings[key] = on
        b.Text = txt .. (on and " : ON" or " : OFF")
        b.BackgroundColor3 = on and Color3.fromRGB(150, 60, 240) or Color3.fromRGB(90, 35, 160)
    end)
end

makeBtn("Normal Speed", 35, "NormalSpeed")
makeBtn("Infinity Slide", 90, "InfinitySlide")
makeBtn("Auto Jump", 145, "AutoJump")

RunService.RenderStepped:Connect(function(dt)
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not (hum and root) then return end

    if Settings.AutoJump and hum.FloorMaterial ~= Enum.Material.Air then
        hum:ChangeState(Enum.HumanoidStateType.Jumping)
    end

    if Settings.NormalSpeed then
        hum.WalkSpeed = 35
    end

    if Settings.InfinitySlide and hum.MoveDirection.Magnitude > 0 then
        local sliding = char:GetAttribute("Sliding") or char:GetAttribute("IsSliding")
        if sliding then
            root.CFrame = root.CFrame + (hum.MoveDirection.Unit * (45 * dt))
        end
    end
end)
